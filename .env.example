# Server Configuration
PORT=5000

# Database (MongoDB connection string; fallback local JSON store is enabled if MongoDB is offline)
MONGODB_URI=mongodb://localhost:27017/udyam_digital

# AI LLM Recommendations (Google Gemini API Key)
# If omitted, intelligent deterministic catalogue recommendation fallback is automatically used
GEMINI_API_KEY=gemini_api_key_here

# Cloudinary Storage for KYC Documents
# If omitted, local disk storage under /server/uploads is automatically used as fallback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
